# copy to .env and adjust; docker-compose reads it automatically
SPM_ADMIN_USERNAME=admin
SPM_ADMIN_PASSWORD=change-me
TZ=Europe/Amsterdam
# set SPM_MOCK_PORTAL=1 to boot with the built-in demo portal (test data)
SPM_MOCK_PORTAL=0
