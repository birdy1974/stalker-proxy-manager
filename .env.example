# copy to .env and adjust; docker-compose reads it automatically
SPM_ADMIN_USERNAME=admin
SPM_ADMIN_PASSWORD=change-me
TZ=Europe/Amsterdam

# PUID/PGID - the uid/gid the container runs as.
# The image has a built-in `spm` user (2000/2000), but a bind-mounted host
# folder keeps its HOST ownership: if ./media belongs to another user the app
# cannot even list it ("PermissionError: [Errno 13] ... '/media'").
# Set these to the owner of ./media and re-create the container:
#
#   stat -c '%u:%g' ./media        # or:  id your-user
#   docker compose up -d           # (the entrypoint re-applies ids + chown)
#
#PUID=1000
#PGID=1000
# set SPM_MOCK_PORTAL=1 to boot with the built-in demo portal (test data)
SPM_MOCK_PORTAL=0
# MOCKUP/PREVIEW ONLY: skip admin login (never use on a real deployment)
# SPM_SKIP_LOGIN=1
